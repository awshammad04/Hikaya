# Copy to .env and adjust. Nothing here is secret.

# --- Server ------------------------------------------------------------------
PORT=3000

# --- Database ----------------------------------------------------------------
# Required in production. In development, leave unset to run against the in-memory seed (the same data as
# database/seed.sql). Set it after running:
#   createdb hikaya
#   psql -d hikaya -f database/schema.sql
#   psql -d hikaya -f database/seed.sql
DATABASE_URL=postgresql://user:password@localhost:5432/hikaya

# --- AI module ---------------------------------------------------------------
# The service in ai/. Start it with:  cd ai && python3 -m service.server --port 8001
# If it is unreachable, /ai/generate-story falls back to the stored location
# description and says so in the response.
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT_MS=150000
# Render supplies AI_SERVICE_HOSTPORT if AI_SERVICE_URL is unset.
# Production requires both internal tokens. The Blueprint generates/references them.
HIKAYA_INTERNAL_TOKEN=
AI_INTERNAL_TOKEN=
PG_POOL_MAX=10

# --- Voice contributions -----------------------------------------------------
# Speech-to-text for recorded memories (POST /api/v1/voice/transcribe).
# Without a key the endpoint answers 503 and the rest of the API is unaffected.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Private folder for recordings. Defaults to ./uploads/voice. On Render the
# container disk is wiped on every deploy: mount a persistent disk here, or
# move recordings to object storage before collecting real testimonies.
VOICE_UPLOAD_DIR=
