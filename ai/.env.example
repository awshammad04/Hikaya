# Local development: copy to ai/.env. `python3 -m service.server` and the CLI
# read it; the FastAPI app does not, so on Render set these on the service.
NODE_ENV=development
AI_INTERNAL_TOKEN=
# Model provider. Leave every key empty for the reviewed-content extractive
# engine. "auto" uses Gemini when GEMINI_API_KEY is set, otherwise Anthropic.
HIKAYA_AI_PROVIDER=auto
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Defaults: gemini-3.5-flash (Gemini) or claude-sonnet-5-5 (Anthropic). A model
# name for the other provider is ignored.
HIKAYA_AI_MODEL=
# Gemini only: tried when the main model is overloaded or out of daily quota.
HIKAYA_AI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Optional: developer or vertex; empty tries the Developer API first.
GEMINI_API_MODE=
HIKAYA_AI_MAX_TOKENS=2800
