# --- Hikaya backend ----------------------------------------------------------
# Server-only address of the Hikaya API. Browsers use the same-origin
# `/api/v1` bridge, so phones do not need the computer's Wi-Fi IP address.
HIKAYA_API_BASE_URL="http://127.0.0.1:3000/api/v1"

# --- Dev server --------------------------------------------------------------
# The frontend listens on 5173 so it does not collide with the backend on 3000.
PORT=5173

# --- Natural narration (optional) --------------------------------------------
# Enables the warm online guide voice used by every location story. Without it,
# narration falls back to the best Arabic/English speech voice on the device and
# the interface clearly identifies that fallback.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: public URL when deployed (optional for local development).
APP_URL="MY_APP_URL"

# Render sets NODE_ENV=production and PORT automatically. Production requires:
# APP_URL=https://hikayapalestine.tech
# HIKAYA_API_BASE_URL=http://<backend-private-host>:10000/api/v1
# Or use HIKAYA_API_HOSTPORT supplied by the Blueprint (BASE_URL takes priority).
# Same generated token as the backend; server-only, never a VITE_ variable.
HIKAYA_INTERNAL_TOKEN=
API_PROXY_TIMEOUT_MS=180000
# Browser-visible Maps key. Restrict HTTP referrers and enabled APIs before use.
GOOGLE_MAPS_PLATFORM_KEY=
# Auto-detect Developer API versus Vertex Express key, or set developer/vertex.
GEMINI_API_MODE=
AI_REQUESTS_PER_HOUR=200
VIDEO_REQUESTS_PER_HOUR=10
